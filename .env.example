# Required values have no default and the API refuses to start without them.
# Everything else may be omitted — the value shown is the built-in default, so
# a local .env only needs the required block plus anything you want to change.

# ----------------------------------------------------------------- runtime
NODE_ENV=development
PORT=7000
API_VERSION=v1
LOG_LEVEL=debug

# ------------------------------------------- PostgreSQL (REQUIRED)
DATABASE_URL=postgres://drive:drive@postgres:5432/drive
DATABASE_POOL_MAX=10

# ------------------------------------------------ Redis (REQUIRED)
REDIS_URL=redis://redis:6379

# ---------------------------- S3-compatible object storage (REQUIRED)
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=driveosx
STORAGE_SECRET_KEY=driveosx-secret
STORAGE_REGION=us-east-1
STORAGE_BUCKET=drive-osx
STORAGE_FORCE_PATH_STYLE=true
# Host the browser uses to redeem signed URLs (the API reaches storage internally).
# Optional, but required whenever those two hosts differ — as they do in Docker.
# Must be reachable by every user's browser, not just the server: localhost
# only works for someone on the same machine as the server. If other users
# reach this deployment over a LAN or the internet, set this to that
# reachable address (e.g. the server's LAN IP or public hostname) instead —
# otherwise attachments/images/media will fail to load for everyone else.
STORAGE_PUBLIC_URL=http://localhost:9000

# ------------------------------------------ authentication (REQUIRED)
# At least 16 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=15

# ------------------------------------------------------------------- http
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300

# --------------------------------------------------------------- platform
MAIL_DOMAIN=driveosx.com
# Shared secret proving a request came from the SMTP gateway. Inbound delivery
# (POST /mail/receive) and mailbox credential checks (POST /mail/auth) carry no
# user session, so they present this header instead of a bearer token.
# REQUIRED in production — the API refuses to start without it, because an
# unauthenticated delivery endpoint accepts mail with any forged sender.
# Must be identical to MAIL_GATEWAY_TOKEN in drive-osx-mail/.env.
# Generate with: openssl rand -hex 32
MAIL_GATEWAY_TOKEN=replace-with-a-shared-gateway-secret
MAX_UPLOAD_BYTES=1073741824
INLINE_CONTENT_MAX_BYTES=1048576
DEFAULT_STORAGE_QUOTA_BYTES=16106127360

# ----------------------------------------------------------------- worker
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
# Liveness endpoint for the background process; compose health-checks this port.
WORKER_HEALTH_PORT=7001
